# Local development only. Do not expose this prototype on the public internet.
JOB_HUNTER_ADMIN_TOKEN=replace-with-long-random-secret
RUNTIME_DIR=runtime
# Sources: obtain your own keys at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=za
GREENHOUSE_BOARDS=
LEVER_SITES=
# Outbound email. Use an app password or supported SMTP provider credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=
# Autopilot is OFF until you enable it yourself.
AUTO_APPLY_ENABLED=false
AUTO_APPLY_MIN_SCORE=90
AUTO_APPLY_DAILY_LIMIT=3
# Exact addresses in this list ONLY; a manual job must ALSO declare email applications allowed.
APPROVED_APPLICATION_EMAILS=

# Optional: Use Bedrock to draft tailored letters when you explicitly click Prepare.
# Bedrock sends redacted CV evidence and vacancy descriptions to AWS and incurs usage charges.
# Requires AWS credentials with permission to invoke this model. Disabled by default.
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
